# Built inside the image
vendor
node_modules
public/build
public/hot

# Secrets are passed when the container starts, never baked in
.env
.env.*
!.env.example
!.env.production.example
auth.json

# Local state: cached manifests here list dev-only packages and would break --no-dev
bootstrap/cache/*.php
storage/logs/*
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/views/*
storage/app/private/*
storage/app/public/*
storage/pail
database/*.sqlite

# Not needed to run the app
.git
.github
.idea
.vscode
.claude
.agents
.ai
.junie
docs
graphify-out
tests
phpunit.xml
compose*.yaml
Dockerfile
.dockerignore
docker
