APP_NAME="Pixelforge Studio"
# Proxied through Cloudflare (orange cloud), SSL/TLS mode "Full (strict)"
APP_DOMAIN=studio.example.com
APP_KEY=
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

DB_DATABASE=pixelforge
DB_USERNAME=pixelforge
# A long random string
DB_PASSWORD=

# A long random string
REDIS_PASSWORD=

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=

PIXELFORGE_BASE_URL=https://pixelforge.promptedit.dev/v1
# The production key, not your local one
PIXELFORGE_API_KEY=
# whsec_... of the production key. Webhook URL in the Pixelforge dashboard: https://APP_DOMAIN/webhooks/pixelforge
PIXELFORGE_WEBHOOK_SECRET=
PIXELFORGE_TIMEOUT=10
PIXELFORGE_MARKUP_BPS=2500
PIXELFORGE_WEBHOOK_TOLERANCE=300
